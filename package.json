{
  "name": "eisballis-markdown-viewer",
  "productName": "Eisballis Markdown Viewer",
  "version": "1.0.0",
  "description": "Leichtgewichtiger Markdown-Viewer und -Editor fuer Windows und Linux",
  "main": "src/main.js",
  "author": {
    "name": "Eisballi",
    "email": "eisballi@users.noreply.github.com"
  },
  "homepage": "https://github.com/Eisballi/eisballis-markdown-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eisballi/eisballis-markdown-viewer.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/sync-vendor.mjs",
    "start": "node scripts/sync-vendor.mjs && electron .",
    "pack": "node scripts/sync-vendor.mjs && electron-builder --dir",
    "dist": "node scripts/sync-vendor.mjs && electron-builder",
    "dist:win": "node scripts/sync-vendor.mjs && electron-builder --win",
    "dist:linux": "node scripts/sync-vendor.mjs && electron-builder --linux",
    "icons": "python scripts/make-icons.py"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "marked": "^18.1.2"
  }
}
